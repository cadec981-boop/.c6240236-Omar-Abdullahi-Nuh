public class StudentManagementSystem {

    private int StudentID;
    private String SName;
    private int SAge;
    private String Dept;
    private double Gpa;

    public static String universityName = "AL NAJDI UNIVERSITY";

    StudentManagementSystem(int studentID, String SName, int SAge, String Dept, double Gpa) {

        this.StudentID = studentID;
        this.SName = SName;
        this.SAge = SAge;
        this.Dept = Dept;

        if (SAge >= 18) {
            this.SAge = SAge;
        } else {
            this.SAge = 18;
        }

        if (Gpa >= 0 && Gpa <= 4.0) {
            this.Gpa = Gpa;
        } else {
            this.Gpa = 0.0;
        }
    }

    public void displayInfo() {
        System.out.println("Student ID: " + StudentID);
        System.out.println("Name: " + SName);
        System.out.println("Age: " + SAge);
        System.out.println("Department: " + Dept);
        System.out.println("GPA: " + Gpa);
        System.out.println("University: " + universityName);

        checkpass();

        System.out.println("-------------------------");
    }

    public void checkpass() {
        if (Gpa >= 2.0) {
            System.out.println("Status: Passed");
        } else {
            System.out.println("Status: Failed");
        }
    }

    public static void main(String[] args) {

        StudentManagementSystem student1 =
                new StudentManagementSystem(101, "Ali", 20,
                        "Computer Science", 3.5);

        StudentManagementSystem student2 =
                new StudentManagementSystem(102, "Ahmed", 21,
                        "Information Technology", 2.8);

        StudentManagementSystem student3 =
                new StudentManagementSystem(103, "Hodan", 19,
                        "Software Engineering", 1.8);

        StudentManagementSystem student4 =
                new StudentManagementSystem(104, "Amina", 22,
                        "Computer Engineering", 3.9);

        student1.displayInfo();
        student2.displayInfo();
        student3.displayInfo();
        student4.displayInfo();
    }
}
